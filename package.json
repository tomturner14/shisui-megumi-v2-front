{
  "name": "front",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "dev:vinext": "vite dev --host 127.0.0.1 --port 3001",
    "build:vinext": "vite build",
    "start:vinext": "wrangler dev --local --ip 127.0.0.1 --port 3001 --config dist/server/wrangler.json --persist-to .wrangler/state",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:seed": "wrangler d1 execute DB --local --file scripts/seed.sql",
    "typecheck": "next typegen && tsc --noEmit",
    "test:unit": "tsx --test tests/cart.test.ts tests/checkout.test.ts tests/e2e-safety.test.ts",
    "test:d1": "tsx --conditions=react-server --test tests/d1.test.ts tests/order-lifecycle.test.ts",
    "test:e2e": "playwright test",
    "orders:expire:local": "tsx --conditions=react-server scripts/expire-local-orders.ts"
  },
  "dependencies": {
    "next": "^16.4.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-server-dom-webpack": "^19.2.7",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@cloudflare/workers-types": "^5.20261014.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitejs/plugin-rsc": "^0.5.37",
    "eslint": "^9",
    "eslint-config-next": "^16.4.0",
    "postcss": "^8.5.30",
    "sass": "^1.101.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vinext": "^1.2.0",
    "vite": "^8.3.4",
    "vite-css-modules": "^1.16.0",
    "wrangler": "^4.151.0"
  },
  "allowScripts": {
    "sharp@0.34.5": true,
    "unrs-resolver@1.12.2": true,
    "@parcel/watcher@2.6.0": true
  },
  "type": "module",
  "overrides": {
    "satori": {
      "fflate": "0.7.5"
    }
  }
}
