{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shisui-megumi-local",
  "compatibility_date": "2026-10-14",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "vinext/server/fetch-handler",
  "assets": {
    "directory": "dist/client",
    "html_handling": "none",
    "not_found_handling": "none",
    "binding": "ASSETS",
    "run_worker_first": [
      "/*",
      "!/_next/static/*",
      "!/*/_next/static/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shisui-megumi-local",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "migrations",
      "remote": false
    }
  ],
  "workers_dev": false,
  "preview_urls": false
}
